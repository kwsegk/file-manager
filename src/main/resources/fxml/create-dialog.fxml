<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="180.0" maxWidth="443.0" minHeight="-Infinity" minWidth="-Infinity" prefHeight="174.0" prefWidth="443.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="by.egor.controller.CreateDialogController">
   <children>
      <Label id="labelTitle" prefHeight="49.0" prefWidth="134.0" text="Создание файла">
         <font>
            <Font size="18.0" />
         </font>
         <opaqueInsets>
            <Insets bottom="5.0" />
         </opaqueInsets>
      </Label>
      <Separator prefHeight="18.0" prefWidth="327.0" />
      <HBox prefHeight="56.0" prefWidth="327.0">
         <children>
            <Label alignment="CENTER" prefHeight="42.0" prefWidth="124.0" text="Имя файла:" />
            <Region prefHeight="76.0" prefWidth="78.0" />
            <TextField fx:id="txtName" alignment="CENTER" prefHeight="26.0" prefWidth="220.0" promptText="newfile.txt">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <HBox.margin>
                  <Insets right="20.0" top="10.0" />
               </HBox.margin>
            </TextField>
         </children>
      </HBox>
      <HBox prefHeight="44.0" prefWidth="327.0">
         <children>
            <Label alignment="CENTER" prefHeight="30.0" prefWidth="146.0" text="Расположение:" />
