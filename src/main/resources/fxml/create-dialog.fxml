                  <Insets bottom="20.0" left="15.0" top="15.0" />
               </HBox.margin>
            </Button>
            <Region prefHeight="61.0" prefWidth="265.0" />
            <Button fx:id="btnCancel" cancelButton="true" mnemonicParsing="false" onAction="#cancel" text="Отмена">
               <HBox.margin>
