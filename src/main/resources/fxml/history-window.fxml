<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="by.egor.controller.HistoryController">
   <top>
      <Label text="История" BorderPane.alignment="CENTER">
         <font>
            <Font size="26.0" />
         </font>
      </Label>
   </top>
   <center>
      <TableView fx:id="historyTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="operationColumn" prefWidth="130.0" text="Операция" />
            <TableColumn fx:id="filenameColumn" prefWidth="329.0" text="Имя файла" />
            <TableColumn fx:id="timestampColumn" prefWidth="140.0" text="Время изменения" />
        </columns>
      </TableView>
   </center>
   <bottom>
      <Button fx:id="exitBtn" mnemonicParsing="false" onAction="#exit" text="Закрыть" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
